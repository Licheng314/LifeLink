{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://life-radio.local/contracts/client-profile-v1.schema.json",
  "title": "Life Link client profile v1",
  "description": "A secret-bearing, device-bound profile issued by the central service for one desktop or Android installation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "central_base_url",
    "device",
    "upload_token",
    "issued_at"
  ],
  "properties": {
    "schema_version": {
      "const": "life-radio-client-profile-v1"
    },
    "central_base_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^\\s?#]+(?:/[^\\s?#]*)?$",
      "description": "Absolute HTTPS base URL of the central context service. Query strings and fragments are not allowed."
    },
    "device": {
      "$ref": "#/$defs/enrollment_device"
    },
    "upload_token": {
      "$ref": "#/$defs/token"
    },
    "read_token": {
      "$ref": "#/$defs/token",
      "description": "Optional full-account read credential. Omit for upload-only collector PCs."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "UTC ISO 8601 timestamp generated by the profile issuer."
    }
  },
  "$defs": {
    "enrollment_device": {
      "oneOf": [
        {
          "$ref": "#/$defs/desktop_device"
        },
        {
          "$ref": "#/$defs/android_device"
        }
      ]
    },
    "desktop_device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "platform",
        "display_name"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "pattern": "^desktop-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "The installation-scoped desktop UUID to which upload_token is bound."
        },
        "platform": {
          "const": "desktop"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "android_device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_id",
        "platform",
        "display_name"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "pattern": "^android-install-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "description": "The persisted Android installation UUID to which upload_token is bound."
        },
        "platform": {
          "const": "android"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "token": {
      "type": "string",
      "minLength": 32,
      "pattern": "^\\S+$",
      "description": "A high-entropy secret issued out of band."
    }
  }
}
